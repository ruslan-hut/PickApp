<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Per-line photo capture (in-app CameraX). Camera is optional so the app
         still installs on terminals without one. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- New-document notice buzz -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- New-document notice while the app is in the background or the screen is
         off: a system notification (Android 13+ asks at runtime) and the
         foreground service that keeps the poll alive. specialUse, not dataSync:
         dataSync services are cut after six hours on Android 15. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lights the screen for a few seconds when a notice arrives on a sleeping terminal. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".PickApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pick"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pick">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.notice.QueueNoticeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Polls the server for documents that enter the worker's queue and raises a notification while the app is in the background" />
        </service>

        <!-- FileProvider for sharing exported log bundles from cacheDir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable default WorkManager initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
